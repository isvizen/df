[credential "https://github.com"]
	helper =
	helper = !/usr/bin/env gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/env gh auth git-credential
[init]
	defaultBranch = main
[pull]
	rebase = false

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    dark = true

    # Theme
    syntax-theme     = base16
    minus-style      = syntax "#3d2b29"
    minus-emph-style = syntax "#783f3a"
    plus-style       = syntax "#293d2b"
    plus-emph-style  = syntax "#3a783f"

[merge]
    conflictStyle = zdiff3
